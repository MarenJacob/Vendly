DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/vendly?pgbouncer=true"
# Direct (non-pooled) connection, used only for prisma db push / migrate during build
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/vendly?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
# Product image/video uploads use Supabase Storage (same project as your
# database — Settings -> API on your Supabase dashboard has all three):
#   NEXT_PUBLIC_SUPABASE_URL      -> "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY -> "anon public" key (safe to expose)
#   SUPABASE_SERVICE_ROLE_KEY     -> "service_role" key (SECRET — server-only,
#                                    never expose this one to the browser)
# You also need a Storage bucket named exactly "product-media", set to Public.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary is no longer the active upload path (kept only as unused code
# in lib/cloudinary.ts) — these are not required.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
# Paystack webhook URL in production:
# https://YOUR_DOMAIN/api/paystack/webhook

# Admin access (set strong values in Vercel/production; never commit real credentials)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-immediately"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
# Optional: set a canonical production URL, e.g. https://shop.yourdomain.com
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Cloudflare Turnstile (bot protection on signup/login) — get keys from
# https://dash.cloudflare.com/?to=/:account/turnstile — optional, forms work
# without it, but signup/login CAPTCHA protection stays off until set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Google Sign-In — Client ID only, no secret needed. Get it from
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type
# "Web application", with your domain under Authorized JavaScript origins).
# Optional — the "Sign in with Google" button is hidden until this is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Gmail SMTP, used to send account-verification emails. GMAIL_APP_PASSWORD is
# a 16-character App Password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Gmail account) — NOT the normal Gmail
# password. Optional — verification emails just log to the server console
# until this is set, so signup still works either way.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
